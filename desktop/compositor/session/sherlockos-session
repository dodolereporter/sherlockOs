#!/bin/sh
# Starts a SherlockOS session, from the login screen (sherlockos.desktop) or from a text console:
# the compositor on the screens of the machine, then the bar, the dock, the notification
# daemon and the launcher inside it.
#
# The programs are looked for next to this script (`just install-session` puts them in
# /usr/local/libexec/sherlockos), or in SHERLOCKOS_BIN. That folder goes at the end of PATH: the
# session finds the launcher there, and Evidence, whose desktop entry runs `evidence`.
# XWayland starts too, for X11 applications; SHERLOCKOS_XWAYLAND=0 leaves it out (see "Real session"
# in docs/compositor.md). SHERLOCKOS_SESSION_BUS chooses the D-Bus session bus, SHERLOCKOS_DATA the
# folder of the application icons and of the portal setting (see below), SHERLOCKOS_WALLPAPERS
# the folder of the wallpapers (see below), SHERLOCKOS_POLKIT_AGENTS
# the polkit agents to try (see "Everyday services" in docs/compositor.md). The log of the session goes to
# $XDG_STATE_HOME/sherlockos/session.log (~/.local/state/sherlockos/session.log): beyond 5 MiB it moves
# to session.log.old and starts again. Ctrl + Alt + Backspace stops the compositor, and the
# session with it.
set -eu

bin="${SHERLOCKOS_BIN:-$(dirname "$(readlink -f "$0")")}"
export XDG_CURRENT_DESKTOP=SherlockOS
export XDG_SESSION_DESKTOP=SherlockOS
export XDG_SESSION_TYPE=wayland

# Whether another graphical session of this user is open (Plasma on another console), from
# logind. That session shares the user's D-Bus session bus with this one.
other_graphical_session() {
	command -v loginctl >/dev/null 2>&1 || return 1
	for id in $(loginctl show-user "$(id -un)" -p Sessions --value 2>/dev/null); do
		[ "$id" = "${XDG_SESSION_ID:-}" ] && continue
		case "$(loginctl show-session "$id" -p Type --value 2>/dev/null)" in
		x11 | wayland | mir)
			[ "$(loginctl show-session "$id" -p State --value 2>/dev/null)" != closing ] &&
				return 0
			;;
		esac
	done
	return 1
}

# The session runs on a D-Bus session bus of its own when another graphical session is open:
# on the shared bus, Qt applications wait 25 s for Plasma's global menu registrar, which does
# not answer them, and the notification daemon finds the name taken (see "D-Bus session bus"
# in docs/compositor.md). SHERLOCKOS_SESSION_BUS=own or shared forces the choice; auto by default.
# The bus daemon is started here, not through `dbus-run-session`: the compositor must stay a
# child of this script, or libseat cannot take the screen ("Resource temporarily unavailable"
# when it opens the card, seen on the author's machine).
case "${SHERLOCKOS_SESSION_BUS:-auto}" in
own) own_bus=1 ;;
shared) own_bus=0 ;;
*) own_bus=0 && other_graphical_session && own_bus=1 ;;
esac
if [ "$own_bus" = 1 ] && command -v dbus-daemon >/dev/null 2>&1 &&
	bus=$(dbus-daemon --session --fork --print-address=1 --print-pid=1); then
	DBUS_SESSION_BUS_ADDRESS=$(printf '%s\n' "$bus" | sed -n 1p)
	bus_pid=$(printf '%s\n' "$bus" | sed -n 2p)
	export DBUS_SESSION_BUS_ADDRESS SHERLOCKOS_OWN_BUS=1
	# The bus goes away with the session, whichever way it ends.
	trap 'kill "$bus_pid" 2>/dev/null' EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM
else
	unset SHERLOCKOS_OWN_BUS
fi

export PATH="$PATH:$bin"
# The data of the session, the application icons as a hicolor theme: in share/sherlockos beside the
# libexec folder (/usr/local/share/sherlockos, where `just install-session` puts them), or in
# SHERLOCKOS_DATA. First in XDG_DATA_DIRS, for the programs of the session only. After the re-exec
# above, so that it is added once.
data="${SHERLOCKOS_DATA:-$(dirname "$(dirname "$bin")")/share/sherlockos}"
export XDG_DATA_DIRS="$data:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# The wallpapers that `just wallpapers` writes beside the programs' folder (target/wallpapers
# when the session runs from the repository with SHERLOCKOS_BIN=target/release) come before the
# installed ones, in <data folder>/sherlockos/wallpapers.
if [ -z "${SHERLOCKOS_WALLPAPERS:-}" ] && [ -d "$(dirname "$bin")/wallpapers" ]; then
	SHERLOCKOS_WALLPAPERS=$(cd "$(dirname "$bin")/wallpapers" && pwd)
	export SHERLOCKOS_WALLPAPERS
fi
state="${XDG_STATE_HOME:-$HOME/.local/state}/sherlockos"
log="$state/session.log"
mkdir -p "$state"
if [ -f "$log" ]; then
	mv -f "$log" "$log.old"
fi
note() {
	printf 'session: %s\n' "$*" >>"$log"
}

# Secrets (lot D-35b): applications keep their passwords through the Secret Service on the
# session bus. gnome-keyring-daemon serves it, started here on the bus of this session; it
# prints the variables that lead to it. Without it, kwalletd6 starts once the display is there
# (below). On a bus of its own, the keyring of a Plasma session open beside this one is not
# reachable: this session has its own, which asks for its password the first time.
keyring=none
if command -v gnome-keyring-daemon >/dev/null 2>&1; then
	if found=$(gnome-keyring-daemon --start --components=secrets 2>>"$log"); then
		keyring=gnome-keyring-daemon
		for line in $found; do
			case "$line" in
			[A-Z]*=*) export "$line" ;;
			esac
		done
	else
		note "gnome-keyring-daemon did not start"
	fi
elif command -v kwalletd6 >/dev/null 2>&1; then
	keyring=kwalletd6
fi
note "keyring: $keyring"
export SHERLOCKOS_KEYRING="$keyring"

# The first polkit agent installed, which asks for the password when an action needs one (lot
# D-35b): started with the shell, below.
agents="${SHERLOCKOS_POLKIT_AGENTS:-/usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1 /usr/libexec/polkit-kde-authentication-agent-1 /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 /usr/libexec/polkit-gnome-authentication-agent-1 lxpolkit}"
agent=""
for candidate in $agents; do
	case "$candidate" in
	/*) [ -x "$candidate" ] && agent=$candidate ;;
	*) agent=$(command -v "$candidate" 2>/dev/null || true) ;;
	esac
	[ -n "$agent" ] && break
done
if [ -n "$agent" ]; then
	note "polkit agent: $agent"
else
	note "warning: no polkit agent installed (polkit-kde-agent-1, policykit-1-gnome or lxpolkit): actions that need a password are refused"
fi
export SHERLOCKOS_POLKIT_AGENT="$agent"

# The PAM service of the lock screen (lot D-25a): without it, PAM falls back to its `other`
# service, which refuses every password on Debian, and the session cannot be unlocked.
pam_lock="${SHERLOCKOS_PAM_DIR:-/etc/pam.d}/sherlockos-lock"
if [ ! -f "$pam_lock" ]; then
	note "warning: $pam_lock is missing: the lock screen cannot check the password (just install-session prints the command that installs it)"
fi

# Once `just install-themes` ran, third-party applications take the colors of the desktop
# (docs/third-party-theming.md): the GTK settings live in a dconf database of the session's own,
# libadwaita reads them without the portal, Qt goes through qt6ct. Plasma sees none of it.
themes="${XDG_DATA_HOME:-$HOME/.local/share}/sherlockos/themes"
if [ -f "$themes/dconf-profile" ] && [ -x "$themes/toolkit-theme" ]; then
	export DCONF_PROFILE="$themes/dconf-profile" ADW_DISABLE_PORTAL=1 QT_QPA_PLATFORMTHEME=qt6ct
	export SHERLOCKOS_THEMES="$themes"
fi

# Cursors (lot D-07): every program draws the house theme, the compositor's, so that two themes
# never mix: sherlockos-light if the appearance file gives the light theme now, sherlockos otherwise.
# `cursors` beside the programs' folder is searched first: target/cursors, which `just cursors`
# writes, when the session is tried from the repository with SHERLOCKOS_BIN=target/release.
appearance="${XDG_CONFIG_HOME:-$HOME/.config}/appearance/appearance.conf"
cursors=sherlockos
if [ -r "$appearance" ]; then
	cursors=$(awk -F= -v now="$(date +%H:%M:%S)" '
		function secs(t, f) { split(t, f, ":"); return f[1] * 3600 + f[2] * 60 + f[3] }
		/^[ \t]*\[/ { group = $0; gsub(/[][ \t]/, "", group); next }
		group == "Appearance" { k = $1; v = $2; gsub(/[ \t]/, "", k); gsub(/[ \t]/, "", v); a[k] = v }
		END {
			light = secs(("AutoLightFrom" in a) ? a["AutoLightFrom"] : "07:00")
			dark = secs(("AutoDarkFrom" in a) ? a["AutoDarkFrom"] : "19:00")
			n = secs(now)
			day = light < dark ? (n >= light && n < dark) : (n >= light || n < dark)
			print (a["Theme"] == "light" || (a["Theme"] == "auto" && day)) ? "sherlockos-light" : "sherlockos"
		}' "$appearance")
fi
icons="${XDG_DATA_HOME:-$HOME/.local/share}/icons:$HOME/.icons:/usr/local/share/icons:/usr/share/icons"
export XCURSOR_PATH="$(dirname "$bin")/cursors:${XCURSOR_PATH:-$icons:/usr/share/pixmaps}"
export XCURSOR_THEME="$cursors"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

# Copies its input to the log, which moves to .old beyond 5 MiB (checked every 100 lines).
keep_log() {
	lines=0
	while IFS= read -r line; do
		printf '%s\n' "$line" >>"$log"
		lines=$((lines + 1))
		if [ $((lines % 100)) -eq 0 ] && [ "$(wc -c <"$log")" -gt 5242880 ]; then
			mv -f "$log" "$log.old"
		fi
	done
}

# The compositor launches this command once it is ready, with WAYLAND_DISPLAY (and DISPLAY
# with XWayland). The bar, the dock and the notification daemon start again when they stop
# (ADR 0005), as long as the compositor, their parent's parent, is there: after 1, 2, 4, 8 then
# 16 seconds. A program that stopped 5 times within 60 seconds is given up, with a line in the
# log.
shell='
compositor=$PPID
# The services the bus starts (the portals, kwalletd6) learn the display of this session, its
# name (the portals read sherlockos-portals.conf for it) and its data folders (where that file is).
# On the shared bus of the user, those systemd starts learn it too.
systemd=--systemd
if [ "${SHERLOCKOS_OWN_BUS:-0}" = 1 ]; then
	echo "session: D-Bus session bus of its own" >&2
	systemd=""
fi
# shellcheck disable=SC2086 # $systemd is empty or one word.
dbus-update-activation-environment $systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP \
	XDG_SESSION_DESKTOP XDG_SESSION_TYPE XDG_DATA_DIRS ||
	echo "session: the activation environment of the bus is not updated" >&2
keep() {
	stops=""
	delay=1
	while kill -0 "$compositor" 2>/dev/null; do
		"$@" && status=0 || status=$?
		now=$(date +%s)
		recent=""
		for t in $stops $now; do
			[ $((now - t)) -lt 60 ] && recent="$recent $t"
		done
		stops=$recent
		if [ "$(echo $stops | wc -w)" -ge 5 ]; then
			echo "session: $1 stopped 5 times within 60 s (last status $status): given up" >&2
			return
		fi
		# After a quiet minute, the delay starts again from 1 second.
		[ "$(echo $stops | wc -w)" -eq 1 ] && delay=1
		echo "session: $1 stopped (status $status), started again in $delay s" >&2
		sleep "$delay"
		[ "$delay" -lt 16 ] && delay=$((delay * 2))
	done
}
keep "$0/bar" &
keep "$0/dock" &
keep "$0/notifications" &
# The launcher stays in memory, hidden (lot P-02): Super + Space starts `launcher`, which only asks
# it to show or hide, so that it appears at once.
keep "$0/launcher" --resident &
# The polkit agent, started again like the shell programs, and kwalletd6 without
# gnome-keyring-daemon (lot D-35b).
[ -n "${SHERLOCKOS_POLKIT_AGENT:-}" ] && keep "$SHERLOCKOS_POLKIT_AGENT" &
[ "${SHERLOCKOS_KEYRING:-}" = kwalletd6 ] && kwalletd6 &
# Switches the GTK theme and the Qt palette with the appearance file.
[ -n "${SHERLOCKOS_THEMES:-}" ] && keep "$SHERLOCKOS_THEMES/toolkit-theme" follow &
wait
'
xwayland=--xwayland
if [ "${SHERLOCKOS_XWAYLAND:-1}" = 0 ]; then
	xwayland=""
fi
# shellcheck disable=SC2086 # $xwayland is empty or one word.
"$bin/compositor" $xwayland sh -c "$shell" "$bin" 2>&1 | keep_log
