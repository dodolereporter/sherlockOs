#!/bin/sh
# Starts a NOM_OS session, from the login screen (sherlockos.desktop) or from a text console:
# the compositor on the screens of the machine, then the bar, the dock and the notification
# daemon inside it.
#
# The programs are looked for next to this script (`just install-session` puts them in
# /usr/local/libexec/nom-os), or in NOM_OS_BIN. That folder goes at the end of PATH: the
# session finds the launcher there, and Evidence, whose desktop entry runs `evidence`. NOM_OS_XWAYLAND=1 starts XWayland too (off by
# default: see "Real session" in docs/compositor.md). The log of the session goes to
# $XDG_STATE_HOME/nom-os/session.log (~/.local/state/nom-os/session.log): beyond 5 MiB it moves
# to session.log.old and starts again. Ctrl + Alt + Backspace stops the compositor, and the
# session with it.
set -eu

bin="${NOM_OS_BIN:-$(dirname "$(readlink -f "$0")")}"
state="${XDG_STATE_HOME:-$HOME/.local/state}/nom-os"
log="$state/session.log"
mkdir -p "$state"
if [ -f "$log" ]; then
	mv -f "$log" "$log.old"
fi

export PATH="$PATH:$bin"
export XDG_CURRENT_DESKTOP=NOM_OS
export XDG_SESSION_DESKTOP=NOM_OS
export XDG_SESSION_TYPE=wayland
# Cursors (lot D-07): every program draws the house theme, the compositor's, so that two themes
# never mix: nom-os-light if the appearance file gives the light theme now, nom-os otherwise.
# `cursors` beside the programs' folder is searched first: target/cursors, which `just cursors`
# writes, when the session is tried from the repository with NOM_OS_BIN=target/release.
appearance="${XDG_CONFIG_HOME:-$HOME/.config}/appearance/appearance.conf"
cursors=nom-os
if [ -r "$appearance" ]; then
	cursors=$(awk -F= -v now="$(date +%H:%M:%S)" '
		function secs(t, f) { split(t, f, ":"); return f[1] * 3600 + f[2] * 60 + f[3] }
		/^[ \t]*\[/ { group = $0; gsub(/[][ \t]/, "", group); next }
		group == "Appearance" { k = $1; v = $2; gsub(/[ \t]/, "", k); gsub(/[ \t]/, "", v); a[k] = v }
		END {
			light = secs(("AutoLightFrom" in a) ? a["AutoLightFrom"] : "07:00")
			dark = secs(("AutoDarkFrom" in a) ? a["AutoDarkFrom"] : "19:00")
			n = secs(now)
			day = light < dark ? (n >= light && n < dark) : (n >= light || n < dark)
			print (a["Theme"] == "light" || (a["Theme"] == "auto" && day)) ? "nom-os-light" : "nom-os"
		}' "$appearance")
fi
icons="${XDG_DATA_HOME:-$HOME/.local/share}/icons:$HOME/.icons:/usr/local/share/icons:/usr/share/icons"
export XCURSOR_PATH="$(dirname "$bin")/cursors:${XCURSOR_PATH:-$icons:/usr/share/pixmaps}"
export XCURSOR_THEME="$cursors"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

# Copies its input to the log, which moves to .old beyond 5 MiB (checked every 100 lines).
keep_log() {
	lines=0
	while IFS= read -r line; do
		printf '%s\n' "$line" >>"$log"
		lines=$((lines + 1))
		if [ $((lines % 100)) -eq 0 ] && [ "$(wc -c <"$log")" -gt 5242880 ]; then
			mv -f "$log" "$log.old"
		fi
	done
}

# The compositor launches this command once it is ready, with WAYLAND_DISPLAY (and DISPLAY
# with XWayland). The bar, the dock and the notification daemon start again when they stop
# (ADR 0005), as long as the compositor, their parent's parent, is there: after 1, 2, 4, 8 then
# 16 seconds. A program that stopped 5 times within 60 seconds is given up, with a line in the
# log.
shell='
compositor=$PPID
keep() {
	stops=""
	delay=1
	while kill -0 "$compositor" 2>/dev/null; do
		"$@" && status=0 || status=$?
		now=$(date +%s)
		recent=""
		for t in $stops $now; do
			[ $((now - t)) -lt 60 ] && recent="$recent $t"
		done
		stops=$recent
		if [ "$(echo $stops | wc -w)" -ge 5 ]; then
			echo "session: $1 stopped 5 times within 60 s (last status $status): given up" >&2
			return
		fi
		# After a quiet minute, the delay starts again from 1 second.
		[ "$(echo $stops | wc -w)" -eq 1 ] && delay=1
		echo "session: $1 stopped (status $status), started again in $delay s" >&2
		sleep "$delay"
		[ "$delay" -lt 16 ] && delay=$((delay * 2))
	done
}
keep "$0/bar" &
keep "$0/dock" &
keep "$0/notifications" &
wait
'
xwayland=""
if [ "${NOM_OS_XWAYLAND:-0}" = 1 ]; then
	xwayland=--xwayland
fi
# shellcheck disable=SC2086 # $xwayland is empty or one word.
"$bin/compositor" $xwayland sh -c "$shell" "$bin" 2>&1 | keep_log
