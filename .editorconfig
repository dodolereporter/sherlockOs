root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Deux espaces en fin de ligne forcent un retour à la ligne en Markdown.
trim_trailing_whitespace = false

[docs/design/**]
# Fichiers fournis tels quels : l'éditeur ne doit pas les retoucher.
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
