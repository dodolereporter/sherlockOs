root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces force a line break in Markdown.
trim_trailing_whitespace = false

[docs/design/**]
# Files provided as is: the editor must not touch them.
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
