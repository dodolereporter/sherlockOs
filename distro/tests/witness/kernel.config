# Options added to `make tinyconfig` for the kernel of the witness image.
# build.sh checks that each of them ends up as is in the final .config.
# The path of the initramfs (CONFIG_INITRAMFS_SOURCE) is added by build.sh.

# Run /init, a static 64-bit ELF, from the initramfs built into the kernel
CONFIG_64BIT=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y

# Boot as a UEFI application (ADR 0001): OVMF starts the kernel from the EFI partition
CONFIG_ACPI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Serial port: the bench reads the BOOT-OK line there
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Screen: text console on the framebuffer left by UEFI, for the screenshot
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Built-in command line: the firmware passes none.
# The last console gets /dev/console, hence the output of /init.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=tty0 console=ttyS0,115200"
