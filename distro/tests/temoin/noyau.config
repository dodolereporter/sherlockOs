# Options ajoutées à `make tinyconfig` pour le noyau de l'image témoin.
# construire.sh vérifie que chacune se retrouve telle quelle dans le .config final.
# Le chemin de l'initramfs (CONFIG_INITRAMFS_SOURCE) est ajouté par construire.sh.

# Exécuter /init, un ELF statique 64 bits, depuis l'initramfs intégré au noyau
CONFIG_64BIT=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y

# Démarrer comme application UEFI (ADR 0001) : OVMF lance le noyau depuis la partition EFI
CONFIG_ACPI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Port série : le banc y lit la ligne BOOT-OK
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Écran : console texte sur le tampon d'image laissé par UEFI, pour la capture d'écran
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Ligne de commande intégrée : le micrologiciel n'en passe aucune.
# La dernière console reçoit /dev/console, donc la sortie de /init.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=tty0 console=ttyS0,115200"
